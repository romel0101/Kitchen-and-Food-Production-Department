Options -Indexes
DirectoryIndex index.php

RewriteEngine On

# ---- 403: code and data folders, hidden files and dumps are never served (shows error.php) ----
RewriteRule ^(config|includes|sections|database)(/|$) error.php?code=403 [L]
RewriteRule (^|/)\.(?!well-known) error.php?code=403 [L]
RewriteRule \.(sql|log|md|env|ini|bak|rar|zip)$ error.php?code=403 [NC,L]

# ---- Pretty URLs: /inventory -> index.php?page=inventory (unknown names show the 404 page inside the app) ----
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_-]+)$ index.php?page=$1 [QSA,L]

# ---- 403: a folder with no index page (e.g. /assets/) is not browsable ----
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.php !-f
RewriteRule ^.+ error.php?code=403 [L]

# ---- 404: any other address that does not exist (a missing image/css/js file gets the plain server 404) ----
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.(css|js|map|png|jpe?g|gif|svg|ico|webp|woff2?|ttf)$ [NC]
RewriteRule ^ error.php?code=404 [L]

# Safety net if mod_rewrite is off: still block dumps and notes.
<FilesMatch "\.(sql|log|md|env|ini|bak|rar|zip)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>
